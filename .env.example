APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Defrilex practice test list (optional; see config/defrilex_test_deployment.php)
DEFRILEX_SHOW_DEPLOYMENT_BADGES=false
DEFRILEX_PRACTICE_LIST_HERO_NOTE=

# AI personalized course generation
# OPENAI_API_KEY is read either from admin settings (open_ai_secret_key) or from here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini — lesson narration (TTS) and practice-test speaking transcription
AI_ASSISTANT_NAME=Léa
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_AUDIO_MODEL=gemini-2.0-flash

# YouTube Data API v3 key for fetching teaching videos for each generated lesson.
# Without this key, lessons fallback to a YouTube search link instead of embedded videos.
YOUTUBE_API_KEY=

# HeyGen avatar video generation (optional, takes priority over YouTube when set).
# When set, each generated lesson produces a real AI presenter video read aloud from an AI script.
# Get your API key at https://app.heygen.com/settings?nav=API
# Defaults below use the free "Daisy" demo avatar / voice.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=Daisy-inskirt-20220818
HEYGEN_VOICE_ID=2d5b0e6cf36f460aa7fc47e3eee4ba54
HEYGEN_VOICE_ID_FR=
HEYGEN_VOICE_ID_ES=
HEYGEN_PREFER_ONLY=true
